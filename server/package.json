{
  "name": "lineclear",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Run many coding agents across machines from a phone, tablet or desktop. A herdr plugin.",
  "scripts": {
    "plugins": "bun scripts/build-plugins.ts",
    "build": "bun scripts/build-plugins.ts",
    "start": "bun server/main.ts",
    "typecheck": "bun scripts/build-plugins.ts && tsc --noEmit",
    "typecheck:changed": "bun scripts/build-plugins.ts && tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc-changed.tsbuildinfo",
    "test": "bun scripts/test.ts",
    "check": "bun run typecheck && bun scripts/test.ts"
  },
  "dependencies": {
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/web-push": "3.6.4",
    "typescript": "5.9.3"
  }
}
