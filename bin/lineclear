#!/usr/bin/env bun
import { join } from "node:path";
import { commands, main } from "../src/cli.ts";
import { stableRefusal } from "../src/paths.ts";

const args = process.argv.slice(2);
// a word that is no command touches no folder or port: let the CLI name it
const refusal = args[0] !== undefined && !(args[0] in commands) && !args[0].startsWith("-") ? "" : stableRefusal(join(import.meta.dir, ".."), args);
if (refusal) {
  console.error(`lineclear: ${refusal}`);
  process.exit(2);
}
process.exit(await main(args));
